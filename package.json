{
  "name": "nepali-date-library",
  "private": true,
  "version": "1.1.16",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=8"
  },
  "license": "MIT",
  "author": "Sandip Ghimire",
  "homepage": "https://nepali-pkg.date/docs/nodejs",
  "repository": {
    "type": "git",
    "url": "https://github.com/SandipGhimire/Nepali-Date-Library-NodeJS.git"
  },
  "bugs": {
    "url": "https://github.com/SandipGhimire/Nepali-Date-Library-NodeJS/issues"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm run lint",
    "lint": "eslint src --max-warnings 0 --flag unstable_native_nodejs_ts_config",
    "lint:fix": "eslint src --max-warnings 0 --fix --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:compat": "node test/compat/smoke.cjs",
    "build:esbuild": "pnpm run build:esbuild:cjs && pnpm run build:esbuild:mjs",
    "build:esbuild:cjs": "esbuild src/index.ts --bundle --platform=node --target=node8 --format=cjs --outfile=dist/index.cjs",
    "build:esbuild:mjs": "esbuild src/index.ts --bundle --platform=neutral --target=es2019 --format=esm --outfile=dist/index.mjs",
    "build:babel": "pnpm run build:babel:cjs && pnpm run build:terser:cjs && pnpm run build:babel:mjs && pnpm run build:terser:mjs",
    "build:babel:cjs": "babel dist/index.cjs --out-file dist/index.cjs --config-file ./babel.config.json",
    "build:terser:cjs": "terser dist/index.cjs -c -m -o dist/index.cjs",
    "build:babel:mjs": "babel dist/index.mjs --out-file dist/index.mjs --config-file ./babel.config.json",
    "build:terser:mjs": "terser dist/index.mjs -c -m -o dist/index.mjs",
    "build": "tsc --emitDeclarationOnly && pnpm run build:esbuild && pnpm run build:babel",
    "format": "prettier --write src/",
    "prepare": "git-sentry init"
  },
  "description": "Fast, zero-dependency Nepali Date (Bikram Sambat / BS) converter and calendar library for TypeScript and JavaScript. Bidirectional BS to AD / AD to BS conversion, fiscal year, date arithmetic, and Devanagari formatting.",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "git-sentry": "^1.0.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "terser": "^5.49.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "date converter",
    "nepali date converter",
    "nepali date",
    "nepali date library",
    "bikram sambat",
    "bikram sambat date converter",
    "bikram sambat converter",
    "bs to ad",
    "ad to bs",
    "bs to ad converter",
    "ad to bs converter",
    "bs date",
    "nepali calendar",
    "nepali patro",
    "nepali miti",
    "nepali age calculator",
    "nepali fiscal year",
    "aarthik barsha",
    "nepali",
    "nepal",
    "typescript",
    "javascript",
    "nodejs",
    "date-converter",
    "nepali-date-converter",
    "bs-to-ad",
    "ad-to-bs",
    "bikram-sambat"
  ]
}